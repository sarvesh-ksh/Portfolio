# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# MongoDB connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/wallet_db?retryWrites=true&w=majority

# JWT secret (use a long random string)
JWT_SECRET=your_super_secret_jwt_key_here

# Razorpay API credentials (get from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Server port
PORT=5000

# Frontend URL (for CORS) - use your Vite dev URL
CLIENT_URL=http://localhost:5173

# Minimum amounts in Rupees
MIN_DEPOSIT=10
MIN_BET=10
MAX_BET=10000
